{
  "name": "hono-boilerplate",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "build:lambda": "tsx scripts/build-lambda-package.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "^7.1.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "hono": "^4.11.1",
    "hono-rate-limiter": "^0.5.0",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.7.4",
    "prisma": "^7.1.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^20.11.17",
    "@types/pg": "^8.16.0",
    "archiver": "^7.0.1",
    "esbuild": "^0.27.2",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3",
    "vitest": "^4.0.16"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "linux",
        "windows",
        "darwin"
      ],
      "cpu": [
        "x64",
        "arm64"
      ],
      "libc": [
        "glibc",
        "musl"
      ]
    }
  }
}